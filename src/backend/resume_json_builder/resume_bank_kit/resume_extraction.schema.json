{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed resume bank v1",
  "description": "Schema 1.0 remains compatible. Fact keys are open. Conventions added without a version bump: listed_date, listed_coursework, associated_organization, proposed_related_experience_id, source_platform, and repeated multi-value keys. Consumers must not index facts by key alone. Confirmation still cannot be set by the parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "is_fictional_example",
    "updated_at",
    "sources",
    "evidence",
    "person",
    "education",
    "experience",
    "projects",
    "skills",
    "awards",
    "certifications",
    "publications",
    "volunteering",
    "languages",
    "preferences",
    "other_experiences",
    "inventory_coverage",
    "open_questions",
    "conflicts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "is_fictional_example": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "person": {
      "$ref": "#/$defs/entity"
    },
    "inventory_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "volunteering": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "other_experiences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "assertion_status": {
          "enum": [
            "extracted",
            "confirmed",
            "needs_review",
            "disputed",
            "withdrawn"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "confirmation_evidence_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "key",
        "value",
        "assertion_status",
        "evidence_ids",
        "confirmation_evidence_id",
        "confirmed_by",
        "confirmed_at"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      },
      "required": [
        "id",
        "facts"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "resume",
            "user_interview",
            "user_confirmation",
            "portfolio",
            "repository",
            "document",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "fictional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "captured_at",
        "fictional"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source_id",
        "locator",
        "quote"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "not_started",
            "in_progress",
            "reviewed",
            "skipped"
          ]
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "last_reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "category",
        "state",
        "entity_ids",
        "last_reviewed_at",
        "evidence_ids"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            "missing",
            "ambiguous",
            "conflicting",
            "discovery",
            "confirmation"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "open",
            "answered",
            "skipped"
          ]
        }
      },
      "required": [
        "id",
        "entity_id",
        "field_key",
        "question",
        "reason",
        "evidence_ids",
        "state"
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "field_key": {
          "type": "string",
          "minLength": 1
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution_evidence_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "entity_id",
        "field_key",
        "fact_ids",
        "description",
        "state",
        "resolution_evidence_id"
      ]
    }
  }
}
